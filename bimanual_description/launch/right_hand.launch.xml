<launch>
    <let name="urdf_path"
         value="$(find-pkg-share amber_urdf_description)/urdf/right_hand.urdf"/>

    <let name="rviz_config_path"
         value="$(find-pkg-share amber_urdf_description)/rviz/right_hand.rviz"/>

    <node pkg="robot_state_publisher"
          exec="robot_state_publisher"
          name="robot_state_publisher"
          output="screen">
        <param name="robot_description"
               value="$(command 'cat $(var urdf_path)')"/>
    </node>

    <node pkg="joint_state_publisher_gui"
          exec="joint_state_publisher_gui"
          name="joint_state_publisher_gui"
          output="screen"/>

    <node pkg="rviz2"
          exec="rviz2"
          name="rviz2"
          output="screen"
          args="-d $(var rviz_config_path)"/>
  
</launch>
